MODULE Module1
    CONST robtarget INSERTAR_PIEZA:=[[65,340,3],[1,0,0,0],[-1,1,-2,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    
    !caso 1
    !CONST robtarget TOMAR_PIEZA:=[[0,0,20],[0.5,0.5,-0.5,0.5],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    !caso 2
    CONST robtarget TOMAR_PIEZA:=[[0,0,20],[1,0,0,0],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    
    
    CONST pose pinza_to_perno:=[[90,0,0],[0.7071,0,0.7071,0]];
    
    PROC main()
        !Add your code here
        !TCP_perno.tframe := PoseMult(Pinza.tframe, pinza_to_perno);
        
        test_path;

    ENDPROC

    PROC test_path()

        VAR num offset1:=50;
        VAR num offset2 := 150;
        VAR num offset3 := 150;
        
        !Herramienta nueva
            
        !Soltar pieza
        SetDO DO_Pinza,0;

        !Aproximacion para agarrar
        MoveJ Offs(TOMAR_PIEZA,0,offset1,0),v1000,fine,Pinza\WObj:=REF_Perno;
        MoveL TOMAR_PIEZA,v1000,fine,Pinza\WObj:=REF_Perno;
    
        !Agarrar Pieza
        SetDO DO_Pinza,1;
        
        !Separase del punto de toma
        MoveL Offs(TOMAR_PIEZA,0,offset2,0),v1000,fine,Pinza\WObj:=REF_Perno;

        !Ir hasta el hueco
        MoveJ Offs(INSERTAR_PIEZA,0,0, -offset3),v1000,fine,TCP_perno\WObj:=REF_Mesa;
        
        !Insertar
        MoveL INSERTAR_PIEZA,v1000,fine,TCP_perno\WObj:=REF_Mesa;
        
        !Soltar Pieza
        SetDO DO_Pinza,0;

        !Salir del hueco
        MoveL Offs(INSERTAR_PIEZA,0,0, -offset3),v1000,fine,TCP_perno\WObj:=REF_Mesa;
        
        
    ENDPROC
ENDMODULE